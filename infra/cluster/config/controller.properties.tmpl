# KRaft controller. Rendered per node (Terraform templatefile in AWS, scripts/render-config.py in the spike).
process.roles=controller
node.id=${node_id}
controller.quorum.voters=${quorum_voters}
listeners=CONTROLLER://:9093
controller.listener.names=CONTROLLER
listener.security.protocol.map=CONTROLLER:PLAINTEXT
log.dirs=/var/lib/kafka/data

authorizer.class.name=org.apache.kafka.metadata.authorizer.StandardAuthorizer
allow.everyone.if.no.acl.found=false
# CONTROLLER listener is PLAINTEXT, locked down by security group: its principal is ANONYMOUS
super.users=User:ANONYMOUS;User:admin;User:broker;User:trainer
